---
// Banque d'images : filtres par pays, recherche, grille chargée 64 par 64,
// fenêtre photo, diaporama, « Ma sélection ».
import Base from '../layouts/Base.astro';
import Visionneuse from '../components/Visionneuse.astro';
import pays from '../data/pays.json';
import catalogue from '../data/catalogue.json';
import { lien } from '../lien.js';

const total = catalogue.length.toLocaleString('fr-FR');
---
<Base
  titre="Banque d'images"
  description={`Banque d'images de plus de ${total} photographies d'Yves Peyrot, classées par pays (France, Islande, Chili, Italie, Espagne, Royaume-Uni, Hawaï), avec recherche par mot-clé et sélection d'images à partager.`}
  actif="galerie"
>
  <div class="page">
    <h1 class="cache">Banque d'images</h1>
    <nav class="pays" aria-label="Pays">
      {pays.map((p) => <a href={lien(`galerie/?pays=${p.slug}`)} data-pays={p.slug}>{p.bouton}</a>)}
    </nav>
    <div class="onglets">
      <a href={lien('tirages-alternatifs/')}>Alternatif</a>
      <a href={lien('gomme-bichromatee/')}>Gomme Bichromatée</a>
      <a class="toutes" href={lien('galerie/')} data-pays="">Toutes les images</a>
    </div>

    <div class="outils">
      <form class="recherche" role="search" action={lien('galerie/')}>
        <label class="cache" for="q">Rechercher par mot ou par nom d'image</label>
        <input id="q" name="q" type="search" placeholder="Mot-clé ou nom d'image" autocomplete="off" enterkeyhint="search" />
        <button class="bouton plein" type="submit">ok</button>
      </form>
      <button type="button" class="bouton" id="diaporama" aria-label="Diaporama"><span class="mot">Diaporama</span> ▶</button>
    </div>

    <p class="resultat" id="resultat" aria-live="polite">Chargement du catalogue…</p>
    <ul class="grille" id="grille"></ul>
    <div id="suite" aria-hidden="true"></div>
    <noscript>
      <p class="resultat">La banque d'images a besoin de JavaScript. Chaque photo a aussi sa page, par exemple <a href={lien('photo/fra0001/')}>FRA0001</a>.</p>
    </noscript>
  </div>
  <Visionneuse />
</Base>

<style>
  .pays { display: flex; flex-wrap: wrap; justify-content: center; gap: 2px 6px; margin-top: 22px; }
  .pays a {
    font-family: var(--titre); font-size: 16px; letter-spacing: 0.04em; color: var(--or);
    padding: 6px 12px; border-radius: 999px;
  }
  .pays a:hover { background: var(--fond-3); }
  .pays a.actif { background: var(--or); color: #000; }
  .onglets { margin-top: 14px; }
  .onglets a.actif { box-shadow: inset 0 -3px 0 var(--or); }
  .outils { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; align-items: center; margin-bottom: 8px; }
  .recherche { display: flex; gap: 8px; flex: 1 1 340px; max-width: 560px; }
  .recherche input {
    flex: 1; min-width: 0; background: var(--fond-2); color: var(--texte); border: 1px solid #3a3a3a;
    border-radius: 999px; padding: 9px 16px; font: inherit; font-size: 15px;
  }
  .recherche input:focus { border-color: var(--or); outline: none; }
  .resultat { text-align: center; color: var(--gris); font-size: 14px; margin: 10px 0 18px; }
  .resultat :global(button) { background: none; border: 0; color: var(--or); text-decoration: underline; padding: 0; }
  .grille {
    list-style: none; margin: 0; padding: 0; display: grid; gap: 22px 18px;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
  }
  .grille :global(li) { min-width: 0; }
  .grille :global(.vignette) { position: relative; display: block; aspect-ratio: 4 / 3; }
  .grille :global(.vignette img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; transition: transform 0.25s; }
  .grille :global(.vignette:hover img) { transform: scale(1.03); }
  .grille :global(.legende) { display: flex; justify-content: center; align-items: center; gap: 8px; margin-top: 6px; }
  .grille :global(.id) { font-family: var(--titre); font-size: 14px; letter-spacing: 0.05em; color: var(--texte); }
  .grille :global(.ajout) {
    width: 26px; height: 26px; border-radius: 50%; border: 1px solid #444; background: transparent;
    color: var(--gris); font-size: 16px; line-height: 1; display: grid; place-items: center; padding: 0;
  }
  .grille :global(.ajout:hover) { border-color: var(--or); color: var(--or); }
  .grille :global(.ajout[aria-pressed='true']) { background: var(--or); border-color: var(--or); color: #000; }
  .grille :global(li.choisie .id) { color: var(--or); }
  @media (max-width: 560px) {
    .grille { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px 10px; }
    .grille :global(.legende) { gap: 4px; }
    .grille :global(.id) { font-size: 12px; letter-spacing: 0.02em; }
    .grille :global(.ajout) { width: 28px; height: 28px; }
    .pays { margin-top: 12px; gap: 0 2px; }
    .pays a { font-size: 14px; padding: 4px 8px; }
    .onglets { margin: 10px auto 14px; }
    .outils { flex-wrap: nowrap; }
    .recherche { flex: 1 1 auto; }
    #diaporama { padding: 8px 14px; }
    #diaporama .mot { display: none; }
    .resultat { margin: 8px 0 12px; }
  }
</style>

<script>
  import { chargerCatalogue, chercher } from '../scripts/catalogue.js';
  import { basculer, suivre } from '../scripts/selection.js';
  import { creerVisionneuse } from '../scripts/visionneuse.js';
  import { photoHd, photoMini, pagePhoto } from '../lien.js';
  import pays from '../data/pays.json';

  const PAR_LOT = 64;
  const grille = document.getElementById('grille');
  const resultat = document.getElementById('resultat');
  const champ = document.getElementById('q');
  const vis = creerVisionneuse({ selection: true });
  let tout = [];
  let liste = [];
  let affichees = 0;
  let choisies = new Set();

  const params = new URLSearchParams(location.search);
  let filtrePays = pays.find((p) => p.slug === params.get('pays'))?.code || '';
  champ.value = params.get('q') || '';

  const nf = (n) => n.toLocaleString('fr-FR');

  function majAdresse() {
    const p = new URLSearchParams();
    const slug = pays.find((x) => x.code === filtrePays)?.slug;
    if (slug) p.set('pays', slug);
    if (champ.value.trim()) p.set('q', champ.value.trim());
    const s = p.toString();
    history.replaceState(null, '', location.pathname + (s ? `?${s}` : ''));
  }

  function majBoutons() {
    for (const a of document.querySelectorAll('[data-pays]')) {
      const code = pays.find((x) => x.slug === a.dataset.pays)?.code || '';
      const actif = code === filtrePays && (a.dataset.pays !== '' || !filtrePays);
      a.classList.toggle('actif', actif);
      if (actif) a.setAttribute('aria-current', 'true'); else a.removeAttribute('aria-current');
    }
  }

  function filtrer() {
    const base = filtrePays ? tout.filter((c) => c.pays === filtrePays) : tout;
    liste = chercher(base, champ.value);
    grille.replaceChildren();
    affichees = 0;
    const nomPays = pays.find((x) => x.code === filtrePays)?.nom;
    const q = champ.value.trim();
    let txt = `${nf(liste.length)} image${liste.length > 1 ? 's' : ''}`;
    if (nomPays) txt += ` · ${nomPays}`;
    if (q) txt += ` · « ${q} »`;
    resultat.textContent = txt;
    if (!liste.length) {
      resultat.textContent = `Aucun résultat${q ? ` pour « ${q} »` : ''}${nomPays ? ` en ${nomPays}` : ''}. `;
      if (nomPays && q) {
        const b = document.createElement('button');
        b.textContent = 'Chercher dans tous les pays';
        b.onclick = () => { filtrePays = ''; majBoutons(); majAdresse(); filtrer(); };
        resultat.append(b);
      }
    }
    suite();
  }

  function suite() {
    const frag = document.createDocumentFragment();
    for (const c of liste.slice(affichees, affichees + PAR_LOT)) {
      const i = affichees++;
      const li = document.createElement('li');
      li.classList.toggle('choisie', choisies.has(c.id));
      li.innerHTML = `<a class="vignette" href="${pagePhoto(c.id)}" data-i="${i}"><img src="${photoMini(c.id)}" alt="" loading="lazy" decoding="async"></a>
        <div class="legende"><span class="id">${c.id}</span><button type="button" class="ajout" data-id="${c.id}"></button></div>`;
      li.querySelector('img').alt = c.alt || c.id;
      majBouton(li.querySelector('.ajout'), choisies.has(c.id));
      frag.append(li);
    }
    grille.append(frag);
  }

  function majBouton(b, oui) {
    b.setAttribute('aria-pressed', String(oui));
    b.textContent = oui ? '✓' : '+';
    b.setAttribute('aria-label', `${oui ? 'Retirer' : 'Ajouter'} ${b.dataset.id} ${oui ? 'de' : 'à'} ma sélection`);
    b.title = oui ? 'Dans ma sélection (cliquer pour retirer)' : 'Ajouter à ma sélection';
  }

  const items = () => liste.map((c) => ({ id: c.id, src: photoHd(c.id), alt: c.alt, titre: c.alt, texte: c.description, lien: pagePhoto(c.id) }));

  grille.addEventListener('click', (e) => {
    const b = e.target.closest('.ajout');
    if (b) { basculer(b.dataset.id); return; }
    const a = e.target.closest('.vignette');
    if (a && !e.metaKey && !e.ctrlKey && !e.shiftKey) {
      e.preventDefault();
      vis.ouvrir(items(), Number(a.dataset.i));
    }
  });

  document.getElementById('diaporama').addEventListener('click', () => vis.ouvrir(items(), 0, { diaporama: true }));

  for (const a of document.querySelectorAll('[data-pays]')) {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      filtrePays = pays.find((x) => x.slug === a.dataset.pays)?.code || '';
      if (a.dataset.pays === '') champ.value = '';
      majBoutons(); majAdresse(); filtrer();
    });
  }

  let attente;
  champ.addEventListener('input', () => { clearTimeout(attente); attente = setTimeout(() => { majAdresse(); filtrer(); }, 250); });
  document.querySelector('.recherche').addEventListener('submit', (e) => { e.preventDefault(); clearTimeout(attente); majAdresse(); filtrer(); champ.blur(); });

  new IntersectionObserver((ent) => { if (ent[0].isIntersecting && affichees < liste.length) suite(); }, { rootMargin: '900px' })
    .observe(document.getElementById('suite'));

  suivre((ids) => {
    choisies = new Set(ids);
    for (const b of grille.querySelectorAll('.ajout')) {
      const oui = choisies.has(b.dataset.id);
      majBouton(b, oui);
      b.closest('li').classList.toggle('choisie', oui);
    }
  });

  majBoutons();
  chargerCatalogue()
    .then((c) => { tout = c; filtrer(); })
    .catch(() => { resultat.textContent = 'Le catalogue n’a pas pu être chargé. Vérifiez la connexion, puis rechargez la page.'; });
</script>
